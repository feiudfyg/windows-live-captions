<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LiveCaptions.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LiveCaptions.Models">

    <Grid x:Name="RootGrid">
        <Border
            x:Name="Panel"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="#26FFFFFF"
            Background="{Binding PanelBrush, Source={StaticResource Ui}}"
            PointerPressed="Panel_PointerPressed"
            PointerMoved="Panel_PointerMoved"
            PointerReleased="Panel_PointerReleased"
            PointerCaptureLost="Panel_PointerCaptureLost"
            PointerEntered="Panel_PointerEntered"
            PointerExited="Panel_PointerExited">

            <Grid Padding="16,10,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="EmptyHint"
                    Text="实时字幕 · 点击工具栏 ▶ 开始监听"
                    FontSize="14"
                    Foreground="#66FFFFFF"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

                <ScrollViewer
                    x:Name="LinesScroll"
                    Grid.Row="0"
                    IsHitTestVisible="False"
                    VerticalScrollBarVisibility="Hidden"
                    VerticalScrollMode="Auto"
                    ZoomMode="Disabled">
                    <ItemsControl x:Name="LinesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:CaptionItem">
                                <StackPanel Margin="0,1">
                                    <TextBlock
                                        Text="{x:Bind Original, Mode=OneWay}"
                                        Visibility="{x:Bind OriginalVisibility, Mode=OneWay}"
                                        Opacity="{x:Bind OriginalOpacity, Mode=OneWay}"
                                        FontSize="{Binding OriginalFontSize, Source={StaticResource Ui}}"
                                        Foreground="#A6FFFFFF"
                                        FontFamily="Microsoft YaHei UI, Segoe UI"
                                        TextWrapping="Wrap"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Translation, Mode=OneWay}"
                                        Visibility="{x:Bind TranslationVisibility, Mode=OneWay}"
                                        Opacity="{x:Bind TranslationOpacity, Mode=OneWay}"
                                        FontSize="{Binding TranslationFontSize, Source={StaticResource Ui}}"
                                        Foreground="#FFFFFFFF"
                                        FontFamily="Microsoft YaHei UI, Segoe UI"
                                        TextWrapping="Wrap"
                                        MaxLines="3"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ProgressRing
                            x:Name="LoadRing"
                            Width="14"
                            Height="14"
                            IsActive="False"
                            Visibility="Collapsed"
                            Foreground="#CCFFFFFF" />
                        <TextBlock
                            x:Name="StatusText"
                            Text="{Binding StatusText, Source={StaticResource Ui}}"
                            FontSize="11"
                            Foreground="#80FFFFFF"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel
                        x:Name="Toolbar"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="2"
                        Opacity="0">
                        <Button
                            x:Name="ListenButton"
                            Click="ListenButton_Click"
                            Style="{StaticResource OverlayButtonStyle}"
                            ToolTipService.ToolTip="开始 / 暂停监听">
                            <FontIcon x:Name="ListenIcon" Glyph="&#xE768;" FontSize="12" />
                        </Button>
                        <ToggleButton
                            x:Name="TranslateToggle"
                            Click="TranslateToggle_Click"
                            Style="{StaticResource OverlayButtonStyle}"
                            ToolTipService.ToolTip="翻译开 / 关（关闭后仅显示原文字幕）">
                            <FontIcon x:Name="TranslateIcon" Glyph="&#xE774;" FontSize="12" />
                        </ToggleButton>
                        <Button
                            Click="ClearButton_Click"
                            Style="{StaticResource OverlayButtonStyle}"
                            ToolTipService.ToolTip="清空字幕">
                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                        </Button>
                        <Button
                            Click="SettingsButton_Click"
                            Style="{StaticResource OverlayButtonStyle}"
                            ToolTipService.ToolTip="设置">
                            <FontIcon Glyph="&#xE713;" FontSize="12" />
                        </Button>
                        <Button
                            Click="CloseButton_Click"
                            Style="{StaticResource OverlayButtonStyle}"
                            ToolTipService.ToolTip="退出">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="设置…" Click="SettingsButton_Click" />
                    <MenuFlyoutItem Text="翻译开 / 关（仅原文字幕）" Click="TranslateMenu_Click" />
                    <MenuFlyoutItem Text="清空字幕" Click="ClearButton_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="退出" Click="CloseButton_Click" />
                </MenuFlyout>
            </Border.ContextFlyout>
        </Border>

        <Border
            x:Name="ResizeGrip"
            Width="20"
            Height="20"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#00000000"
            PointerPressed="Grip_PointerPressed"
            PointerMoved="Grip_PointerMoved"
            PointerReleased="Grip_PointerReleased"
            PointerCaptureLost="Grip_PointerCaptureLost">
            <FontIcon Glyph="&#xE744;" FontSize="10" Foreground="#55FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" />
        </Border>
    </Grid>
</Window>
